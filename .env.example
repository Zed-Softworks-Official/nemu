# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# Clerk (apps/web + apps/dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# App origins (standalone subdomain apps)
# Local defaults; production: https://nemu.sh and https://app.nemu.sh
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Convex (apps/web + apps/dashboard + packages/cloud)
# After `pnpm --filter @nemu/cloud dev`, copy CONVEX_URL from packages/cloud/.env.local
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Convex dashboard / local backend (packages/cloud)
# Clerk JWT issuer domain (Frontend API URL) for the Convex "convex" JWT template
CLERK_JWT_ISSUER_DOMAIN=
# Optional: shared secret for controller registration + relay respond
CONTROLLER_REGISTRATION_SECRET=

# LAN hostname + Let's Encrypt (Convex Node actions only — never on the Pi)
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# NEMU_LAN_ZONE=nemu.sh
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Use the staging directory only when testing issuance:
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CONTACT_EMAIL=

# nemu-core (apps/core)
DATABASE_URL=postgres://nemu:nemu@localhost:5432/nemu
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_BASE_TOPIC=zigbee2mqtt
# Matter MQTT dialect from nemu-matter. Empty disables Matter.
MQTT_MATTER_BASE_TOPIC=matter
# NEMU_LISTEN_ADDR=0.0.0.0:6368
# Opportunistic TLS on the same port (default on). Set NEMU_TLS=0 to disable.
# NEMU_TLS=1
# NEMU_TLS_SAN=192.168.1.50
# NEMU_TLS_CERT_PATH=/path/to/cert.pem
# NEMU_TLS_KEY_PATH=/path/to/key.pem
# Convex HTTP actions base (*.convex.site), used for registration + relay poll
# NEMU_CONVEX_SITE_URL=https://your-deployment.convex.site
# NEMU_CONTROLLER_NAME=Home
# CONTROLLER_REGISTRATION_SECRET=  # same value as packages/cloud when set
