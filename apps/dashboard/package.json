{
    "name": "@nemu/dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "next build",
        "check": "biome check .",
        "check:unsafe": "biome check --write --unsafe .",
        "check:write": "biome check --write .",
        "dev": "pnpm with-env next dev --turbo --port 3001",
        "preview": "next build && next start",
        "start": "next start",
        "check-types": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "with-env": "dotenv -e ../../.env --"
    },
    "dependencies": {
        "@clerk/nextjs": "catalog:",
        "@clerk/ui": "catalog:",
        "@nemu/assets": "workspace:*",
        "@nemu/cloud": "workspace:*",
        "@nemu/controller": "workspace:*",
        "@nemu/protocol": "workspace:*",
        "@nemu/ui": "workspace:*",
        "@t3-oss/env-nextjs": "^0.13.11",
        "lucide-react": "^1.23.0",
        "motion": "^12.42.2",
        "next": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "recharts": "3.8.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@nemu/biome-config": "workspace:*",
        "@nemu/typescript-config": "workspace:*",
        "@tailwindcss/postcss": "catalog:",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "^6.3.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.3",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vitest": "^5.1.1"
    },
    "ct3aMetadata": {
        "initVersion": "7.40.0"
    }
}
