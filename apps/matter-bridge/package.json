{
    "name": "@nemu/matter-bridge",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "MATTERJS_RESTART_CMD='docker restart nemu-matterjs-server-1' tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
        "test": "tsx --test src/*.test.ts",
        "check": "biome check .",
        "check:write": "biome check --write .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@matter-server/ws-client": "^1.4.0",
        "mqtt": "^5.15.2",
        "ws": "^8.18.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@nemu/biome-config": "workspace:*",
        "@nemu/typescript-config": "workspace:*",
        "@types/node": "catalog:",
        "@types/ws": "^8.18.1",
        "esbuild": "^0.25.0",
        "tsx": "^4.19.0",
        "typescript": "catalog:"
    }
}
