{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "allowImportingTsExtensions": true,
        "types": ["node", "jest"],
        "paths": {
            "~/assets/*": ["./assets/*"],
            "~/*": ["./src/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "../../packages/assets/types.d.ts"
    ]
}
