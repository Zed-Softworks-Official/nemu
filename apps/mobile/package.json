{
    "name": "@nemu/mobile",
    "version": "1.0.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "pnpm with-env expo start",
        "dev:web": "pnpm with-env expo start",
        "dev:android": "pnpm with-env expo start --android",
        "dev:ios": "pnpm with-env expo start --ios",
        "web": "pnpm with-env expo start --web",
        "with-env": "dotenv -e ../../.env --",
        "check": "biome check .",
        "check:unsafe": "biome check --write --unsafe .",
        "check:write": "biome check --write .",
        "lint": "biome check .",
        "check-types": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "expo:install": "pnpm dlx expo install",
        "expo:uninstall": "pnpm remove",
        "expo:update": "pnpm dlx expo install --check",
        "expo:cli": "pnpm expo login"
    },
    "dependencies": {
        "@clerk/expo": "^4.14.1",
        "@clerk/expo-native-components": "^0.4.2",
        "@expo-google-fonts/manrope": "^0.4.3",
        "@expo/ui": "~58.0.25",
        "@nemu/assets": "workspace:*",
        "@nemu/cloud": "workspace:*",
        "@nemu/controller": "workspace:*",
        "@nemu/protocol": "workspace:*",
        "@nemu/ui": "workspace:*",
        "@t3-oss/env-core": "^0.13.11",
        "class-variance-authority": "0.7.1",
        "expo": "~58.0.21",
        "expo-auth-session": "~58.0.16",
        "expo-constants": "~58.0.14",
        "expo-crypto": "^58.0.7",
        "expo-device": "~58.0.5",
        "expo-font": "~58.0.11",
        "expo-glass-effect": "~58.0.5",
        "expo-image": "~58.0.18",
        "expo-linking": "~58.0.15",
        "expo-router": "~58.0.28",
        "expo-secure-store": "^58.0.2",
        "expo-splash-screen": "~58.0.12",
        "expo-status-bar": "~58.0.4",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.7",
        "expo-web-browser": "~58.0.7",
        "lucide-react-native": "^1.63.0",
        "nativewind": "5.0.0-rc.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-native": "0.88.1",
        "react-native-css": "3.1.0-rc.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "^15.16.0",
        "react-native-view-shot": "6.1.1",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.13.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@nemu/biome-config": "workspace:*",
        "@tailwindcss/postcss": "catalog:",
        "@types/react": "catalog:",
        "lightningcss": "1.30.1",
        "postcss": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
    },
    "expo": {
        "install": {
            "exclude": [
                "typescript"
            ]
        }
    },
    "pnpm": {
        "overrides": {
            "lightningcss": "1.30.1"
        }
    }
}
