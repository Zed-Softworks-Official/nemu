{
    "name": "@nemu/mobile",
    "version": "1.0.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "pnpm with-env expo start",
        "dev:android": "pnpm with-env expo start --android",
        "dev:ios": "pnpm with-env expo start --ios",
        "web": "pnpm with-env expo start --web",
        "with-env": "dotenv -e ../../.env --",
        "check": "biome check .",
        "check:unsafe": "biome check --write --unsafe .",
        "check:write": "biome check --write .",
        "lint": "biome check .",
        "check-types": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "reset-project": "node ./scripts/reset-project.js"
    },
    "dependencies": {
        "@expo/ui": "~58.0.23",
        "expo": "~58.0.19",
        "expo-constants": "~58.0.13",
        "expo-device": "~58.0.5",
        "expo-font": "~58.0.10",
        "expo-glass-effect": "~58.0.5",
        "expo-image": "~58.0.17",
        "expo-linking": "~58.0.14",
        "expo-router": "~58.0.26",
        "expo-splash-screen": "~58.0.11",
        "expo-status-bar": "~58.0.4",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.6",
        "expo-web-browser": "~58.0.6",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-web": "~0.21.4",
        "react-native-worklets": "0.13.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.8",
        "@nemu/biome-config": "workspace:*",
        "@types/react": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
    },
    "expo": {
        "install": {
            "exclude": [
                "typescript"
            ]
        }
    }
}
