# Generated/edited by the get.nemu.sh installer. Do not commit real secrets.

POSTGRES_USER=nemu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nemu

# Convex HTTP actions base (*.convex.site) for registration + relay
NEMU_CONVEX_SITE_URL=
NEMU_CONTROLLER_NAME=Home
# Optional shared secret (must match cloud CONTROLLER_REGISTRATION_SECRET)
CONTROLLER_REGISTRATION_SECRET=

# Extra TLS certificate names/IPs (comma-separated). Installer sets the LAN IP.
NEMU_TLS_SAN=
# NEMU_TLS=0

# Zigbee USB serial device on the host
NEMU_ZIGBEE_DEVICE=/dev/ttyACM0

# Watchtower poll interval in seconds (default: 1 hour)
WATCHTOWER_POLL_INTERVAL=3600
# Shared token for Watchtower's internal HTTP API (installer generates this)
WATCHTOWER_HTTP_API_TOKEN=
WATCHTOWER_URL=http://watchtower:8080
WATCHTOWER_IMAGE=ghcr.io/zed-softworks-official/nemu-core

TZ=UTC
