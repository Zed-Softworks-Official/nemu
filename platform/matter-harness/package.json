{
    "name": "@nemu/matter-harness",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check-types": "tsc --noEmit",
        "test": "tsc -p tsconfig.build.json && node --test dist/*.test.js",
        "harness": "tsc -p tsconfig.build.json && node dist/cli.js",
        "harness:record": "tsc -p tsconfig.build.json && node dist/cli.js --record"
    },
    "dependencies": {
        "@matter/main": "0.18.0",
        "mqtt": "5.16.1"
    },
    "devDependencies": {
        "@nemu/typescript-config": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    }
}
