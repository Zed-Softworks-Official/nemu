    "compilerOptions": {
        "allowJs": false,
        "checkJs": false,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": false,
        "rewriteRelativeImportExtensions": true,
        "outDir": "dist/test",
        "rootDir": "src"
