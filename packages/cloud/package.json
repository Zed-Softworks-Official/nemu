{
    "name": "@nemu/cloud",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./api": {
            "types": "./src/functions/_generated/api.d.ts",
            "default": "./src/functions/_generated/api.js"
        },
        "./server": {
            "types": "./src/functions/_generated/server.d.ts",
            "default": "./src/functions/_generated/server.js"
        },
        "./dataModels": {
            "types": "./src/functions/_generated/dataModels.d.ts",
            "default": "./src/functions/_generated/dataModels.js"
        }
    },
    "scripts": {
        "dev": "convex dev",
        "dev:web": "convex dev",
        "convex:dev": "convex dev",
        "convex:deploy": "convex deploy",
        "check-types": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@edge-runtime/vm": "^5.0.0",
        "@nemu/biome-config": "workspace:*",
        "@nemu/typescript-config": "workspace:*",
        "@types/node": "catalog:",
        "convex-test": "^0.0.75",
        "typescript": "catalog:",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@convex-dev/rate-limiter": "^0.4.3",
        "@nemu/protocol": "workspace:*",
        "@t3-oss/env-core": "^0.13.11",
        "acme-client": "^5.4.0",
        "convex": "catalog:",
        "convex-helpers": "^0.1.104",
        "jose": "^6.2.3",
        "zod": "catalog:"
    }
}
